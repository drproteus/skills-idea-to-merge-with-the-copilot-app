---
// Static markup renders at build time. All browser-only behavior (localStorage,
// DOM updates) lives in the client <script> below, which never runs during the build.
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<style is:global>
  .error { margin: 0 0 0.75rem; font-size: 0.85rem; color: #dc2626; }
  .bookmark .sep { color: var(--muted); white-space: pre; }
  .bookmark .url { color: var(--accent); text-decoration: none; font-weight: 600; }
  .bookmark .url:hover { text-decoration: underline; }
  .bookmark .slug { font-family: var(--font-head); }
  li.bookmark { transition: border-color 0.15s, transform 0.15s; }
  li.bookmark:hover { border-color: var(--accent); transform: translateY(-1px); }
</style>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  import {
    STORAGE_KEY,
    SEPARATOR,
    addBookmark,
    parseStoredBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const errorEl = document.getElementById('form-error');

  let bookmarks: Bookmark[] = [];

  function load(): Bookmark[] {
    try {
      return parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Storage unavailable or full; the in-memory list still works.
    }
  }

  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = !message;
  }

  async function copy(text: string, button: HTMLButtonElement): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied!';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => (button.textContent = 'Copy'), 1500);
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const a = document.createElement('a');
      a.className = 'url';
      a.href = bookmark.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = bookmark.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      button.addEventListener('click', () => void copy(bookmark.slug, button));

      li.append(a, sep, slug, button);
      list.append(li);
    }
    const has = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = has;
    if (listHeader) listHeader.hidden = !has;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // first statement: never let the page reload
    try {
      const next = addBookmark(bookmarks, input?.value);
      if (!next) {
        showError('Please enter a valid web address, like example.com.');
        return;
      }
      showError('');
      bookmarks = next;
      save();
      render();
      if (input) input.value = '';
    } catch (err) {
      console.error(err);
      showError('Something went wrong saving that link. Please try again.');
    }
  });

  clearAll?.addEventListener('click', () => {
    try {
      if (!window.confirm('Remove all saved bookmarks?')) return;
      bookmarks = [];
      save();
      render();
    } catch (err) {
      console.error(err);
    }
  });

  try {
    bookmarks = load();
    render();
  } catch (err) {
    console.error(err);
  }
</script>
